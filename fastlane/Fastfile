require "json"

# fastlane would otherwise regenerate fastlane/README.md on every run.
skip_docs
# Don't send fastlane's anonymous usage analytics.
opt_out_usage

ROOT = File.expand_path("..", __dir__)

# GitHub passes unset repository variables as empty strings, which ENV.fetch
# would happily return instead of the default.
def env_or(name, default)
  value = ENV[name].to_s.strip
  value.empty? ? default : value
end

# package.json is the single source of truth for the user-facing version.
APP_VERSION = JSON.parse(File.read(File.join(ROOT, "package.json"))).fetch("version")

# Paths in fastlane/.env may be relative to the repo root.
def repo_path(value)
  File.expand_path(value, ROOT)
end

platform :android do
  # Builds the signed release AAB and returns its path.
  private_lane :signed_bundle do |options|
    version_code = options.fetch(:version_code)
    UI.success("Building #{APP_VERSION} (#{version_code})")

    gradle(
      project_dir: File.join(ROOT, "android"),
      task: "bundle",
      build_type: "Release",
      properties: {
        "versionCode" => version_code,
        "versionName" => APP_VERSION,
        "android.injected.signing.store.file" => repo_path(ENV.fetch("ANDROID_KEYSTORE_PATH")),
        "android.injected.signing.store.password" => ENV.fetch("ANDROID_KEYSTORE_PASSWORD"),
        "android.injected.signing.key.alias" => ENV.fetch("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => ENV.fetch("ANDROID_KEY_PASSWORD"),
      },
    )

    lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
  end

  desc "Build a signed release AAB locally, without uploading"
  desc "Options: version_code (default 1)"
  lane :build do |options|
    aab = signed_bundle(version_code: (options[:version_code] || 1).to_i)
    UI.success("Signed bundle: #{aab}")
  end

  desc "Build a signed release AAB and upload it to Google Play"
  desc "Options: track (default PLAY_TRACK or 'internal')"
  lane :deploy do |options|
    track = options[:track] || env_or("PLAY_TRACK", "internal")

    # A version code must be higher than every code on every track, so look
    # at all of them. Tracks with no releases raise, which counts as none.
    failures = []
    existing = %w[internal alpha beta production].flat_map do |name|
      google_play_track_version_codes(track: name)
    rescue StandardError => e
      failures << "#{name}: #{e.message.lines.first&.strip}"
      []
    end

    # The first release is always uploaded by hand, so some track must have a
    # build. Finding none means the lookups failed (usually credentials or
    # permissions), and guessing version code 1 would collide with that build.
    if existing.empty?
      UI.user_error!(
        "Could not read any existing version codes from Google Play. " \
        "Check your Google credentials and the service account's Play Console access.\n" +
        failures.join("\n"),
      )
    end

    aab = signed_bundle(version_code: existing.max + 1)

    upload_to_play_store(
      track: track,
      aab: aab,
      # Google only accepts "draft" until the app's first release is reviewed.
      release_status: env_or("PLAY_RELEASE_STATUS", "completed"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

platform :ios do
  # App Store Connect API key. CI passes the .p8 contents in
  # APP_STORE_CONNECT_API_KEY_P8; locally, fastlane/.env can point
  # APP_STORE_CONNECT_API_KEY_PATH at the downloaded file instead.
  def asc_api_key
    key = {
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    }
    path = env_or("APP_STORE_CONNECT_API_KEY_PATH", nil)
    if path
      key[:key_filepath] = repo_path(path)
    else
      key[:key_content] = ENV.fetch("APP_STORE_CONNECT_API_KEY_P8")
    end
    app_store_connect_api_key(**key)
  end

  desc "One-time: create the distribution certificate and profile in the match repo"
  desc "Runs on a Mac, or on GitHub via the 'iOS certificates' workflow"
  lane :certificates do
    setup_ci # temporary keychain on CI; does nothing on a local Mac
    match(type: "appstore", readonly: false, api_key: asc_api_key)
  end

  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    setup_ci # temporary keychain, so CI never touches a login keychain
    api_key = asc_api_key

    match(type: "appstore", readonly: true, api_key: api_key)

    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    UI.success("Building #{APP_VERSION} (#{build_number}) for TestFlight")

    # The project uses automatic signing for local development; CI signs
    # manually with the profile match just installed.
    update_code_signing_settings(
      path: File.join(ROOT, "ios/App/App.xcodeproj"),
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_com.adorkable.wikiscroll_appstore_profile-name"),
    )

    build_app(
      project: File.join(ROOT, "ios/App/App.xcodeproj"),
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(ROOT, "build/ios"),
      # Info.plist reads both of these from build settings.
      xcargs: "MARKETING_VERSION=#{APP_VERSION} CURRENT_PROJECT_VERSION=#{build_number}",
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
