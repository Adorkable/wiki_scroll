# Local fastlane settings. `npm run release:setup` copies this to fastlane/.env,
# which fastlane loads automatically and git ignores. Never commit fastlane/.env.
#
# Relative paths are resolved from the repo root. secrets/ is git-ignored and
# is the suggested home for key files; keep backups somewhere safe as well.

# --- Android: signing (`npm run android:keystore` creates the key) ---
ANDROID_KEYSTORE_PATH=secrets/upload.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
# Same as ANDROID_KEYSTORE_PASSWORD for keys made by `npm run android:keystore`
# (PKCS12 keystores have one password). Only differs for older JKS keystores.
ANDROID_KEY_PASSWORD=

# --- Android: Google Play upload ---
# No JSON key needed. CI uses Workload Identity Federation (keyless); set it up
# with `npm run release:gcp-setup`, which fills in the two GCP_ values below.
GCP_PROJECT_ID=
GITHUB_REPOSITORY=
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
#
# Local `npm run android:deploy` uses your own Google login instead:
#   gcloud auth application-default login --scopes="openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/androidpublisher"
# Only if you would rather use a downloaded service account key:
# PLAY_SERVICE_ACCOUNT_JSON_PATH=secrets/play-service-account.json
#
# PLAY_TRACK=internal
# PLAY_RELEASE_STATUS=draft

# --- iOS (see RELEASING.md; no Mac needed, CI does the building) ---
# MATCH_PASSWORD encrypts the signing files; generate a random one and back it up.
APPLE_TEAM_ID=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=secrets/AuthKey.p8
MATCH_GIT_URL=
MATCH_PASSWORD=

# --- GitHub (only used by `npm run release:secrets`) ---
# Token for CI to read the private match repo: fine-grained PAT, Contents: read.
MATCH_GIT_USERNAME=
MATCH_GIT_TOKEN=
